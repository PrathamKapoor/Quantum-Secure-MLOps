"""Model Deployment Service: load approved models and serve verified inference."""
from __future__ import annotations

import json
import time
from typing import Any

from qsmlops.pipeline.training import Dataset  # noqa: F401 (re-exported for typing)
from qsmlops.registry.registry import ModelRegistry, STATE_DEPLOYED


class ServingError(Exception):
    """Raised when the deployment flow refuses to load or serve a model."""


class ModelDeploymentService:
    """Serves the active deployment of a model behind full crypto verification.

    Every load walks the mandatory flow: registry lookup -> passport signature
    verification -> artifact integrity (re-hash + BOM declaration + passport
    binding) -> deserialization. Predictions are logged to the evidence
    ledger with the serving digest so inference history is auditable.
    """

    def __init__(self, registry: ModelRegistry, framework: str = "auto") -> None:
        self.registry = registry
        self.framework = framework
        self._loaded: dict[str, dict] = {}  # model_name -> loaded deployment state

    # ------------------------------------------------------------------
    # Deployment flow
    # ------------------------------------------------------------------
    def load(self, model_name: str, version_id: str | None = None) -> dict:
        """Execute the full deployment flow and cache the loaded model."""
        # Stage 1: Registry
        if version_id is None:
            active = self.registry.active_deployment(model_name)
            if not active:
                raise ServingError(f"no active deployment for model {model_name!r}")
            version_id = active["version_id"]
        rec = self.registry.get_version(version_id)
        if rec["state"] != STATE_DEPLOYED:
            raise ServingError(
                f"refusing to serve version in state {rec['state']!r}; "
                "only DEPLOYED versions may be loaded"
            )

        # Stage 2: Passport verification (ML-DSA over the canonical document)
        passport = self.registry.load_passport(version_id)
        if passport.signature is None:
            raise ServingError(
                f"passport signature is None for {version_id[:12]} ; loading refused"
            )
                try:
                    valid = passport.verify_signature(self.registry.keystore)
                except Exception as e:
                    # Verification failed due to cryptographic error (e.g., expired key)
                    valid = False
                if not valid:
                    signer_record = self.registry.keystore.get_record(passport.signature.signer_key_id)
                    if signer_record.status == "revoked":
                        raise ServingError(f"signing key {signer_record.key_id} is revoked")
                    if signer_record.is_expired():
                        raise ServingError(
                            f"signing key {signer_record.key_id} expired at "
                            f"{signer_record.expires_at}; rotate keys and re-sign before serving"
                        )
                    raise ServingError(
                        f"passport signature verification FAILED for {version_id[:12]} ; loading refused"
                    )
            bom = json.loads(bom_doc.decode("utf-8"))
            declared = any(e["digest"] == rec["artifact_digest"] for e in bom.get("entries", []))
            if not declared:
                raise ServingError("served artifact is not declared in the QML-BOM")

        # Stage 4: Load model (framework-aware)
        model = self._deserialize(artifact_bytes)

        state = {
            "version_id": version_id,
            "model_name": rec["model_name"],
            "version": rec["version"],
            "artifact_digest": rec["artifact_digest"],
            "framework": self._detect_framework(artifact_bytes, passport),
            "loaded_at": time.time(),
            "passport_id": passport.passport_id,
            "signer_key_id": passport.signature.signer_key_id,
            "requests_served": 0,
        }
        state["model"] = model
        self._loaded[model_name] = state
        self.registry.ledger.append({
            "type": "serving_load",
            "model": model_name,
            "version_id": version_id,
            "artifact_digest": rec["artifact_digest"],
            "passport_verified": True,
            "integrity_verified": True,
        })
        return {k: v for k, v in state.items() if k != "model"}

    # ------------------------------------------------------------------
    # Inference
    # ------------------------------------------------------------------
    def predict(self, model_name: str, features: list[list[float]]) -> dict:
        state = self._loaded.get(model_name)
        if state is None:
            state_info = self.load(model_name)
            state = self._loaded[model_name]
        model = state["model"]
        if state["framework"] == "reference":
            weights, bias = model["weights"], model["bias"]
            predictions = [
                sum(w * x for w, x in zip(weights, row)) + bias for row in features
            ]
        else:
            import numpy as np

            predictions = [float(p) for p in model.predict(np.asarray(features, dtype=float))]
        state["requests_served"] += len(features)
        self.registry.ledger.append({
            "type": "inference",
            "model": model_name,
            "version_id": state["version_id"],
            "artifact_digest": state["artifact_digest"],
            "n_requests": len(features),
        })
        return {
            "model": model_name,
            "version_id": state["version_id"],
            "predictions": predictions,
            "requests_served": state["requests_served"],
        }

    def loaded_models(self) -> list[dict]:
        return [{k: v for k, v in s.items() if k != "model"} for s in self._loaded.values()]

    def unload(self, model_name: str) -> None:
        self._loaded.pop(model_name, None)

    # ------------------------------------------------------------------
    # Framework detection / deserialization
    # ------------------------------------------------------------------
    @staticmethod
    def _detect_framework(artifact_bytes: bytes, passport) -> str:
        declared = (passport.training_info or {}).get("framework", "auto")
        if declared in ("sklearn", "pytorch", "tensorflow"):
            return declared
        try:
            json.loads(artifact_bytes.decode("utf-8"))
            if b'"weights"' in artifact_bytes:
                return "reference"
        except (UnicodeDecodeError, json.JSONDecodeError):
            pass
        return "sklearn"  # pickle fallback

    def _deserialize(self, artifact_bytes: bytes) -> Any:
        framework = self.framework
        if framework == "auto":
            try:
                doc = json.loads(artifact_bytes.decode("utf-8"))
                if isinstance(doc, dict) and "weights" in doc:
                    return doc
            except (UnicodeDecodeError, json.JSONDecodeError):
                pass
            framework = "sklearn"
        if framework == "reference":
            return json.loads(artifact_bytes.decode("utf-8"))
        from qsmlops.ml.adapters import get_serializer

        return get_serializer(framework).deserialize(artifact_bytes)
